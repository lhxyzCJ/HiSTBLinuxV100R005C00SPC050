# Hi3798M V300 (hi3798mv300) stage-1 bring-up fragment.
#
# Merged on top of the arm64 defconfig by scripts/kconfig/merge_config.sh, so
# that it keeps working across kernel upgrades instead of pinning a full
# defconfig that rots.
#
# Goal of this stage: reach a userspace shell over the PL011 debug UART.

# --- platform ---
CONFIG_ARCH_HISI=y
CONFIG_ARM64=y
CONFIG_SMP=y

# --- interrupt controller / timers ---
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=n
CONFIG_ARM_ARCH_TIMER=y
# Correct symbol is ARM_PSCI_FW (drivers/firmware/psci/Kconfig). A bare
# CONFIG_PSCI_FW does not exist and olddefconfig silently drops it, which
# would leave the kernel with no PSCI and therefore no SMP on arm64.
CONFIG_ARM_PSCI_FW=y

# --- console ---
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_TTY=y
CONFIG_VT=n

# --- 32-bit userspace support ---
#
# This is the single most valuable option in this file. The HiSTB userspace
# stack (rootfs plus every vendor .so) is AArch32. CONFIG_COMPAT lets those
# 32-bit ARM EL0 binaries keep running on the arm64 kernel, which means the
# ARM64 migration does not force a full userspace rebuild. Only the kernel
# modules in source/msp have to be forward-ported.
CONFIG_COMPAT=y
# COMPAT_VDSO additionally depends on CROSS_COMPILE_COMPAT pointing at a 32-bit
# ARM toolchain (arch/arm64/Kconfig). CI exports CROSS_COMPILE_COMPAT and
# installs gcc-arm-linux-gnueabihf so that this actually takes effect; without
# it olddefconfig quietly turns the option off. Losing it is survivable (glibc
# falls back to real syscalls) but it costs the existing 32-bit userspace its
# fast gettimeofday/clock_gettime path.
CONFIG_COMPAT_VDSO=y

# --- early userspace ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- keep the image small while bringing up ---
CONFIG_MODULES=y
CONFIG_UEVENT_HELPER=n
