# Hi3798M V300 (hi3798mv300) stage-1 bring-up fragment.
#
# Merged on top of the arm64 defconfig by scripts/kconfig/merge_config.sh and
# then run through `make olddefconfig`, so the fragment keeps working across
# kernel upgrades instead of pinning a full defconfig that rots.
#
# Goal of this stage: reach a userspace shell over the PL011 debug UART.
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE EDITING
#
# A fragment line only takes effect if the Kconfig symbol has a *prompt*. For a
# promptless symbol -- one declared `def_bool y`, or `bool "..." if EXPERT` while
# EXPERT is off -- Kconfig ignores the value read from .config and uses the
# default instead (scripts/kconfig/symbol.c: `if (sym->visible != no)` guards
# the user value). Such a line is documentation, not an assertion.
#
# This is not hypothetical. An earlier revision of this file set CONFIG_VT=n
# under a "keep the image small" comment. CONFIG_VT is `bool "..." if EXPERT`
# and EXPERT is off, so the line was silently discarded and the shipped kernel
# has CONFIG_VT=y (out/artifacts/kernel.config:3692). Nothing in the build
# warned: merge_config.sh reported the value as "redefined by fragment", which
# reads like success, and olddefconfig then put it back.
#
# The file is therefore split into two parts:
#   PART 1 - promptful symbols. Lines here can change the build. Most are
#            currently redundant with the arm64 defconfig; they are kept
#            deliberately as insurance against that defconfig drifting.
#   PART 2 - documentation only. Lines here CANNOT change the build. They
#            record what stage 1 depends on. Editing them fixes nothing.
#
# The real guard is CI: the "Verify config fragment survived" step in
# .github/workflows/kernel-6.18.yml asserts these symbols against the
# post-olddefconfig .config and fails the build if one goes missing. That is
# the only thing standing between this file and the next silent drop.
# ---------------------------------------------------------------------------

# ===========================================================================
# PART 1 -- promptful; these lines are live
# ===========================================================================

# --- platform ---
# Promptful (arch/arm64/Kconfig.platforms:154). Already in the arm64 defconfig
# (:55); pinned so a future defconfig change cannot silently drop this SoC.
CONFIG_ARCH_HISI=y

# --- console ---
# Both promptful (drivers/tty/serial/Kconfig:48 and :59) and already in the
# defconfig (:493-494). Load-bearing for stage 1, so pinned rather than assumed.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- 32-bit userspace support ---
#
# The HiSTB userspace stack (rootfs plus every vendor .so) is AArch32.
# CONFIG_COMPAT lets those 32-bit ARM EL0 binaries keep running on the arm64
# kernel, so the ARM64 migration does not force a full userspace rebuild.
#
# What CONFIG_COMPAT does NOT cover is the kernel side: every module in
# source/msp still has to be forward-ported, and that is the larger half of the
# work (see porting/api-drift-report.md).
CONFIG_COMPAT=y

# COMPAT is promptful but CONDITIONAL: `depends on ARM64_4K_PAGES || EXPERT`
# (arch/arm64/Kconfig:1780). Without the pin below it survives only because the
# defconfig happens to leave the 4K page size alone -- so adding any other
# page-size line would silently drop COMPAT and take the whole AArch32
# userspace with it. ARM64_4K_PAGES lives in a promptful choice
# (arch/arm64/Kconfig:1438-1444), so it can be pinned, and is.
CONFIG_ARM64_4K_PAGES=y

# COMPAT_VDSO's dependency is a *string* test, not a toolchain check:
#   depends on (CC_IS_CLANG && LD_IS_LLD) || "$(CROSS_COMPILE_COMPAT)" != ""
# (arch/arm64/Kconfig:1828), and the symbol also has `default y`. So this line
# is not what makes it take effect -- CI exporting CROSS_COMPILE_COMPAT is. A
# bogus non-empty value would satisfy Kconfig and only fail later in the build.
# Losing the option is survivable (glibc falls back to real syscalls) but costs
# the 32-bit userspace its fast gettimeofday/clock_gettime path.
CONFIG_COMPAT_VDSO=y

# --- early userspace ---
# All promptful. BLK_DEV_INITRD and DEVTMPFS are already in the defconfig
# (:30, :252-253); pinned because the stage-1 initramfs depends on them.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- module support ---
# Promptful, already in the defconfig (:125). Note this ADDS code rather than
# trimming it; it is here because the eventual source/msp port will ship modules.
CONFIG_MODULES=y

# ===========================================================================
# PART 2 -- documentation only; these CANNOT affect the build
#
# Every symbol below is promptless in this configuration, so Kconfig discards
# whatever is written here and uses the default. They are listed to record what
# stage 1 depends on. Do not try to fix a problem by editing this section --
# change the device tree, the defconfig, or the arch code instead.
# ===========================================================================

# Selected unconditionally by `config ARM64` itself:
#   ARM64           def_bool y                  arch/arm64/Kconfig:2
#   SMP             def_bool y                  arch/arm64/Kconfig:385
#   ARM_ARCH_TIMER  selected                    arch/arm64/Kconfig:126
#   ARM_GIC         selected                    arch/arm64/Kconfig:127
#   ARM_PSCI_FW     selected                    arch/arm64/Kconfig:133
# ARM_GIC_V3 (:130) and ARM_GIC_V5 (:132) are unconditional too, while
# ARM_GIC_V2M (:129) and ARM_GIC_V3_ITS (:131) carry `if PCI`. That is why
# `CONFIG_ARM_GIC_V3=n` must never be added here: it would be silently
# ineffective. The device tree decides which GIC actually binds -- ours says
# arm,gic-400, i.e. GICv2.
CONFIG_ARM64=y
CONFIG_SMP=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_GIC=y
CONFIG_ARM_PSCI_FW=y

# Promptless by other means:
#   TTY, VT         bool "..." if EXPERT        drivers/tty/Kconfig:2, :13
#   PROC_FS         bool "..." if EXPERT        fs/proc/Kconfig:2
#   SYSFS           bool "..." if EXPERT        fs/sysfs/Kconfig:2
#   SERIAL_EARLYCON promptless, selected by     drivers/tty/serial/Kconfig:9,
#                   SERIAL_AMBA_PL011_CONSOLE    :63
#
# VT is deliberately NOT set to n here. VT, VT_CONSOLE and VT's `select INPUT`
# are all built in, and the only way to turn them off is CONFIG_EXPERT=y, which
# would make dozens of unrelated `if EXPERT` symbols settable and shift their
# defaults -- not worth it for stage 1, and it would need its own boot
# validation. The bootargs pin console=ttyAMA0, so the vt stack is merely dead
# weight, not a hazard.
CONFIG_TTY=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SERIAL_EARLYCON=y
