# config
cfg.mak.old

# VS Code Settings
.vscode/

# out
out/

# auto create links
source/kernel/linux-4.4.y/drivers/bluetooth_usb
source/kernel/linux-4.4.y/drivers/common
source/kernel/linux-4.4.y/drivers/msp
source/kernel/linux-4.4.y/drivers/wifi

# auto create files
source/kernel/linux-4.4.y/scripts/basic/
source/kernel/linux-4.4.y/scripts/kconfig/
source/kernel/linux-4.4.y/.config

# large rootfs images (>100MB, GitHub rejects) - keep local only
*.ext4

# Linux 6.18 LTS tree for the ARM64 forward-port.
# It is ~1.7 GiB extracted, so it is never committed: the CI workflow
# downloads and verifies the tarball from kernel.org and applies
# porting/overlay/ on top. Keep it locally only as a reading reference.
source/kernel/linux-6.18.y/

# porting scratch / build outputs
porting/__pycache__/
porting/*.err

# Directory the CI workflow extracts the kernel into. Not used locally by
# design (compilation is CI-only), but a manual dry-run of the workflow would
# otherwise leave 1.7 GiB untracked-but-unignored in the repo root.
kernel-tree/

# busybox built for the initramfs
busybox-aarch64
busybox.tar.bz2
initramfs.cpio.gz
